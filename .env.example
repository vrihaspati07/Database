# =================================================================
# Hind DB - Sovereign Environment Configuration
# Product: Hind DB
# Parent Company: Hind India Private Limited
# Copyright: © 2026 Hind. A Hind India Private Limited Company.
# =================================================================

# 1. Application Server & URLs
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
HIND_REGION=ap-south-1 (Sovereign)

# 2. Database & Redis Connections
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hind_db
REDIS_URL=redis://localhost:6379

# PostgreSQL Individual Fallbacks (if not using DATABASE_URL)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=hind_db
PG_SSL=false
PG_MAX_POOL=25

# Redis Individual Fallbacks (if not using REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 3. JWT & Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_min_32_chars_long

# 4. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# 5. SMTP Email Configuration (Nodemailer)
# (If not configured in development, verification & reset links are printed to the console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
MAIL_FROM="Hind DB" <noreply@hind.io>

# 6. MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=hind-assets

# 7. Bull Job Queue & Metrics
QUEUE_CONCURRENCY=5
METRICS_ENABLED=true

# 8. Secret Sovereign Admin Panel & Security Shield
ADMIN_EMAILS=tumhara@gmail.com,vrihaspatichaubey@gmail.com
ADMIN_SECRET_PATH=/control-x7k9
ADMIN_SECRET_KEY=HindAdmin@2026!
ADMIN_SESSION_TTL=1800
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_BAN_DURATION_MS=3600000
ADMIN_ALERT_EMAIL=tumhara@gmail.com
RESEND_API_KEY=

# 9. Hind DB Sovereign Storage (Cloudflare R2 Infrastructure Backend)
# End-users only ever see https://storage.hinddb.com URLs and 100% Hind DB branding
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hind-db-storage
R2_BUCKET_ENDPOINT=
STORAGE_PUBLIC_URL=https://storage.hinddb.com
STORAGE_COST_PER_GB_INR=1.25

# 10. Multi-Tenant Database Role Key
TENANT_ROLE_SECRET=your_tenant_role_secret_key_2026

