# =================================================================
# Hind DB - Production Environment Configuration
# Product: Hind DB
# Parent Company: Hind India Private Limited
# Copyright: © 2026 Hind. A Hind India Private Limited Company.
# =================================================================

# 1. Application Server
NODE_ENV=production
PORT=4000
CORS_ORIGIN=*
HIND_REGION=ap-south-1 (Mumbai)

# 2. JWT & Security Secrets
JWT_SECRET=hind_db_super_secret_jwt_key_india_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=hind_db_refresh_secret_2026

# 3. PostgreSQL 16 Sovereign Database
PG_HOST=localhost
PG_PORT=5432
PG_USER=hind_admin
PG_PASSWORD=hind_secure_pass_2026
PG_DATABASE=hind_db_production
PG_SSL=false
PG_MAX_POOL=25

# 4. Redis Cache & Distributed Lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 5. MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hind_minio_admin
MINIO_SECRET_KEY=hind_minio_secret_key_2026
MINIO_BUCKET=hind-assets-mumbai

# 6. Bull Job Queue
QUEUE_CONCURRENCY=5

# 7. Prometheus & Monitoring
METRICS_ENABLED=true
