# =================================================================
# Hind DB - Sovereign Environment Configuration
# Product: Hind DB
# Parent Company: Hind India Private Limited
# Copyright: © 2026 Hind. A Hind India Private Limited Company.
# =================================================================

# 1. Application Server & URLs
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
HIND_REGION=ap-south-1 (Sovereign)

# 2. Database & Redis Connections
DATABASE_URL=postgresql://hind_admin:hind_secure_pass_2026@localhost:5432/hind_db_production
REDIS_URL=redis://localhost:6379

# PostgreSQL Individual Fallbacks (if not using DATABASE_URL)
PG_HOST=localhost
PG_PORT=5432
PG_USER=hind_admin
PG_PASSWORD=hind_secure_pass_2026
PG_DATABASE=hind_db_production
PG_SSL=false
PG_MAX_POOL=25

# Redis Individual Fallbacks (if not using REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 3. JWT & Security Secrets
JWT_ACCESS_SECRET=hind_db_super_access_secret_2026_india_sovereign_key
JWT_SECRET=hind_db_super_access_secret_2026_india_sovereign_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=hind_db_refresh_secret_2026

# 4. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# 5. SMTP Email Configuration (Nodemailer)
# (If not configured in development, verification & reset links are printed to the console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
MAIL_FROM="Hind DB" <noreply@hind.io>

# 6. MinIO S3-Compatible Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=hind_minio_admin
MINIO_SECRET_KEY=hind_minio_secret_key_2026
MINIO_BUCKET=hind-assets

# 7. Bull Job Queue & Metrics
QUEUE_CONCURRENCY=5
METRICS_ENABLED=true
