{
  "name": "database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.js",
    "migrate:up": "node server/db/migrations/migrate.js up",
    "migrate:down": "node server/db/migrations/migrate.js down",
    "migrate:pg:up": "node-pg-migrate -m server/db/migrations up",
    "migrate:pg:down": "node-pg-migrate -m server/db/migrations down",
    "test:auth": "node server/test_auth_suite.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bull": "^4.16.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "minio": "^8.0.7",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
