{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Hind DB Core Telemetry & Cluster Metrics (Mumbai ap-south-1)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "title": "Throughput (RPS)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(hind_db_http_requests_total[1m]))",
          "legendFormat": "Requests / sec",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "title": "API p99 Latency",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(hind_db_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "title": "Active Client Sessions",
      "type": "stat",
      "targets": [
        {
          "expr": "hind_db_active_connections",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 85 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "title": "Redis Cache Hit Ratio",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(hind_db_cache_hits_total[5m])) / (sum(rate(hind_db_cache_hits_total[5m])) + sum(rate(hind_db_cache_misses_total[5m])))) * 100",
          "legendFormat": "Hit Ratio %",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 6,
      "title": "HTTP Traffic Breakdown by Status Code",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hind_db_http_requests_total[1m])) by (status_code)",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 7,
      "title": "Database Query Latency by SQL Operation",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hind_db_query_duration_seconds_sum[1m])) by (operation) / sum(rate(hind_db_query_duration_seconds_count[1m])) by (operation)",
          "legendFormat": "Op: {{operation}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["hind-db", "postgresql", "redis", "minio", "india"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "Asia/Kolkata",
  "title": "Hind DB - Production Cluster Overview",
  "uid": "hind-db-cluster-telemetry",
  "version": 1
